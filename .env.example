# FixFlow environment template
# Copy this file to .env and fill in local values.

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
JWT_ISSUER=FixFlow
JWT_AUDIENCE=FixFlowClients
JWT_SECRET=replace-with-a-long-random-secret

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fixflow
POSTGRES_USER=fixflow
POSTGRES_PASSWORD=replace-with-a-strong-password
CONNECTION_STRING=Host=localhost;Port=5432;Database=fixflow;Username=fixflow;Password=replace-with-a-strong-password

# --- Web ---
VITE_API_BASE_URL=http://localhost:5080

# --- Mobile ---
API_BASE_URL=http://localhost:5080
